# Deploy-Ziele fuer scripts/deploy.sh und scripts/diagnose.sh.
# Kopieren nach deploy/targets.local.env (nicht im Repo) und anpassen.
# Je Ziel: SSH-Ziel, Pfad des Git-Klons dort und Adresse der Proxy-Oberflaeche.
# DEFAULT_TARGET = Ziel ohne --target.

DEFAULT_TARGET="server"

TARGET_server_HOST="user@192.168.1.20"
TARGET_server_REPO="~/ollama-proxy/app"
TARGET_server_URL="http://192.168.1.20:11435/"

# weiteres Ziel, z.B. ein Mac mit launchd
#TARGET_mac_HOST="user@192.168.1.21"
#TARGET_mac_REPO="~/ollama-proxy/app"
#TARGET_mac_URL="http://192.168.1.21:11435/"
