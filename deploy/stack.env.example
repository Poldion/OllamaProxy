# Variablen fuer docker-compose.yml.
# Kopieren nach ~/ollama-proxy/stack.env und anpassen (liegt bewusst ausserhalb des
# Git-Klons, damit "git merge --ff-only" in update.sh nie daran scheitert).

# UID/GID des Host-Users (Ausgabe von: id -u / id -g)
PUID=1000
PGID=1000

# Ollama-Image: "rocm" (ROCm/HIP) oder "latest" (Vulkan). Besser feste Version,
# z.B. 0.40.3-rocm bzw. 0.40.3 — dann passiert ein Update nur, wenn du es willst.
OLLAMA_IMAGE_TAG=rocm

# KV-Cache-Typ: f16 | q8_0 | q4_0 (gilt fuer Ollama UND die Anzeige im Proxy)
OLLAMA_KV_CACHE_TYPE=q8_0

# Wie viele Anfragen ein Modell gleichzeitig bearbeitet / wie viele Modelle
# gleichzeitig geladen sein duerfen
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=3

# Ports und Bindung
PROXY_PORT=11435
OLLAMA_PORT=11434
OLLAMA_BIND=0.0.0.0

# Antwortlaenge je Client-IP begrenzen (Komma-getrennt IP=Token), z.B. Sprachassistent:
# PROXY_MAX_PREDICT_CLIENTS=192.168.1.10=1024

# Module (z.B. ImageGen, FaceRec) stehen in data/modules.json, Vorlage:
# deploy/modules.json.example. Aus dem Container erreicht man Dienste auf dem Host ueber
# http://host.docker.internal:<port>.

# Pfade (relativ zu ~/ollama-proxy/app, wo docker-compose.yml liegt)
# PROXY_DATA_DIR=../data
# OLLAMA_DATA_DIR=../ollama
# OLLAMA_ENV_FILE=../ollama.env
