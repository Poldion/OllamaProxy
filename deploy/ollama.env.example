# Zusaetzliche Umgebungsvariablen fuer den Ollama-Container (optional).
# Kopieren nach ~/ollama-proxy/ollama.env. Ohne Datei laeuft Ollama mit den
# Werten aus docker-compose.yml.

# --- ROCm ---
# Laut Ollama-Doku wird gfx1151 (Ryzen AI Max+ 395) direkt unterstuetzt. Erkennt
# Ollama die GPU trotzdem nicht (laeuft auf CPU), diesen Override probieren:
# HSA_OVERRIDE_GFX_VERSION=11.5.1

# Nur bestimmte AMD-GPUs verwenden (IDs/UUIDs aus rocminfo)
# ROCR_VISIBLE_DEVICES=0

# --- Vulkan (Image-Tag "latest") ---
# Vulkan ganz abschalten:
# OLLAMA_VULKAN=0
# Bestimmte Vulkan-Geraete waehlen (-1 = keine):
# GGML_VK_VISIBLE_DEVICES=0

# --- Prompt-Cache des llama-server begrenzen ---
# llama-server legt Unterhaltungen anderer Clients im RAM ab (Default bis 8192 MiB)
# plus bis zu 32 Context-Checkpoints pro Unterhaltung. Er liest diese Werte aus der
# Umgebung, die er von "ollama serve" erbt (das Erben ist auf dem Mac geprueft,
# die Wirkung der beiden Werte noch nicht -> im Log auf "cache state ... limits:"
# achten).
# LLAMA_ARG_CACHE_RAM=4096
# LLAMA_ARG_CTX_CHECKPOINTS=8

# --- Sonstiges ---
# Ausfuehrliche Logs (docker compose logs ollama)
# OLLAMA_DEBUG=1
